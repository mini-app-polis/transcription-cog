# Google — service account credentials JSON (full JSON string)
# external tooling: consumed by common-python-utils (mini_app_polis.google);
# not declared on transcription_cog Settings.
GOOGLE_CREDENTIALS_JSON=

# LLM providers
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=   # optional — only needed if LLM_PROVIDER=openai

# LLM config
# external tooling: read at runtime by load_config() into Config.llm_provider
# (dataclass-backed). Settings-class checks won't see this; the value is still
# validated against {"anthropic", "openai"} at load time.
LLM_PROVIDER=anthropic
# LLM_MODEL=        # defaults per provider: claude-sonnet-4-6 / gpt-4.1-mini

# Google Drive — folder IDs (required for wcs-transcripts mode)
# external tooling: read into the dataclass-backed Config.notes_input_folder_id.
NOTES_INPUT_FOLDER_ID=
# external tooling: read into the dataclass-backed Config.notes_processed_folder_id.
NOTES_PROCESSED_FOLDER_ID=

# api-kaianolevine-com — internal API (Clerk M2M JWT auth — Project Keystone)
KAIANO_API_BASE_URL=
KAIANO_API_CLERK_MACHINE_SECRET=

# Prefect Cloud configuration. Both keys are external tooling read by the
# Prefect runtime/CLI, not the cog's Settings classes — set in Doppler /
# Railway and never consumed inside transcription_cog.
# external tooling: PREFECT_API_KEY is read by the Prefect runtime/CLI.
PREFECT_API_KEY=
# external tooling: PREFECT_API_URL is read by the Prefect runtime/CLI.
PREFECT_API_URL=

# Observability — each key is read into the dataclass-backed Config at
# load_config() time; not on the pydantic Settings class.
# external tooling: read into Config.sentry_dsn.
SENTRY_DSN_NOTES_INGEST_COG=
# external tooling: read into Config.healthchecks_url.
HEALTHCHECKS_URL=
# external tooling: read into Config.logging_level (also consumed by
# mini_app_polis.logger via the LOGGING_LEVEL convention).
LOGGING_LEVEL=INFO

# Prefect task retries (seconds) — read into the dataclass-backed Config
# (task_retry_delay_short, task_retry_delay_long) for the main WCS pipeline.
# Voicenotes uses its own TASK_RETRIES / TASK_RETRY_DELAYS_SECONDS below.
# external tooling: read into Config.task_retry_delay_short.
TASK_RETRY_DELAY_SHORT=30
# external tooling: read into Config.task_retry_delay_long.
TASK_RETRY_DELAY_LONG=60

# ---------------------------------------------------------------------------
# voicenotes sub-pipeline (merged from voicenotes-cog, May 2026)
#
# These env vars are only read when the router is invoked with
# mode="voicenotes" or mode="voicenotes-cleanup". They live under
# notes_ingest_cog.voicenotes.config.Settings (pydantic-settings).
# ---------------------------------------------------------------------------

# --- LLM providers ---
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY shared with the main WCS pipeline (declared above).

# --- Todoist ---
# Long-lived personal API token (no OAuth, no refresh) — get one from
# app.todoist.com → Settings → Integrations → Developer. Run
# `uv run python -m notes_ingest_cog.voicenotes.scripts.setup_todoist`
# to look up the project ID.
TODOIST_API_TOKEN=
TODOIST_INBOX_PROJECT_ID=

# --- Google Drive ---
# Drive folder where new audio files appear. Reuses the same service
# account JSON as the main pipeline (GOOGLE_CREDENTIALS_JSON above).
GOOGLE_DRIVE_VOICE_INBOX_FOLDER_ID=

# --- Observability ---
# Sentry: voicenotes errors flow through the parent cog's Sentry DSN
# (SENTRY_DSN_NOTES_INGEST_COG above). SENTRY_DSN_VOICENOTES is kept
# for backward compat with operator runbooks; main.py ignores it.
SENTRY_DSN_VOICENOTES=

# --- Behavior tuning (optional) ---
# Defaults are reasonable; override only if needed.
ARCHIVE_RETENTION_DAYS=14
CLAUDE_MODEL=claude-sonnet-4-6
WHISPER_MODEL=whisper-1

# Voicenotes-specific task retries (separate from the WCS retries above
# so the two pipelines can be tuned independently).
TASK_RETRIES=3
TASK_RETRY_DELAYS_SECONDS=[5,15,30]
EXTRACT_TASK_RETRIES=5
EXTRACT_TASK_RETRY_DELAYS_SECONDS=[30,60,120,300,600]
