# Google — service account credentials JSON (full JSON string)
GOOGLE_CREDENTIALS_JSON=

# LLM providers
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=   # optional — only needed if LLM_PROVIDER=openai

# LLM config
LLM_PROVIDER=anthropic
# LLM_MODEL=        # defaults per provider: claude-sonnet-4-6 / gpt-4.1-mini

# Google Drive — folder IDs
NOTES_INPUT_FOLDER_ID=
NOTES_PROCESSED_FOLDER_ID=

# api-kaianolevine-com — internal API (Clerk M2M JWT auth — Project Keystone)
KAIANO_API_BASE_URL=
KAIANO_API_CLERK_MACHINE_SECRET=

# Prefect Cloud
PREFECT_API_KEY=
PREFECT_API_URL=

# Observability
SENTRY_DSN_NOTES_INGEST_COG=
HEALTHCHECKS_URL=
LOGGING_LEVEL=INFO

# Prefect task retries (seconds)
TASK_RETRY_DELAY_SHORT=30
TASK_RETRY_DELAY_LONG=60

# ---------------------------------------------------------------------------
# voicenotes sub-pipeline (merged from voicenotes-cog, May 2026)
#
# These env vars are only read when the router is invoked with
# mode="voicenotes" or mode="voicenotes-cleanup". They live under
# notes_ingest_cog.voicenotes.config.Settings (pydantic-settings).
# ---------------------------------------------------------------------------

# --- LLM providers ---
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY shared with the main WCS pipeline (declared above).

# --- Todoist ---
# Long-lived personal API token (no OAuth, no refresh) — get one from
# app.todoist.com → Settings → Integrations → Developer. Run
# `uv run python -m notes_ingest_cog.voicenotes.scripts.setup_todoist`
# to look up the project ID.
TODOIST_API_TOKEN=
TODOIST_INBOX_PROJECT_ID=

# --- Google Drive ---
# Drive folder where new audio files appear. Reuses the same service
# account JSON as the main pipeline (GOOGLE_CREDENTIALS_JSON above).
GOOGLE_DRIVE_VOICE_INBOX_FOLDER_ID=

# --- Observability ---
# Sentry: voicenotes errors flow through the parent cog's Sentry DSN
# (SENTRY_DSN_NOTES_INGEST_COG above). SENTRY_DSN_VOICENOTES is kept
# for backward compat with operator runbooks; main.py ignores it.
SENTRY_DSN_VOICENOTES=

# --- Behavior tuning (optional) ---
# Defaults are reasonable; override only if needed.
ARCHIVE_RETENTION_DAYS=14
CLAUDE_MODEL=claude-sonnet-4-6
WHISPER_MODEL=whisper-1

# Voicenotes-specific task retries (separate from the WCS retries above
# so the two pipelines can be tuned independently).
TASK_RETRIES=3
TASK_RETRY_DELAYS_SECONDS=[5,15,30]
EXTRACT_TASK_RETRIES=2
EXTRACT_TASK_RETRY_DELAYS_SECONDS=[5,15]
