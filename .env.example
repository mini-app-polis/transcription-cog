# transcription-cog — the names this cog reads. Names only: the values live
# in Doppler (mini-app-polis-ecosystem / dev locally, prd deployed). Run
# under `doppler run -- …`; do not copy this to .env — nothing reads it.
#
# Uncommented names are required in Doppler's dev config, and
# `uv run check-doppler-keys` checks dev holds every one. Commented names
# are optional: the code has a default, or only production reads them. In
# production the Lambda gets these from SSM (secrets) and its function
# environment, both declared in mini-app-polis/infra. How and when the
# worker re-reads them: docs/CONFIGURATION.md.

# ---------------------------------------------------------------------------
# Both pipelines
# ---------------------------------------------------------------------------

# external tooling: read by miniapppolis-common-utils' GoogleAPI.
# Google service account credentials, the full JSON as a string.
GOOGLE_CREDENTIALS_JSON=

# Anthropic API key: the WCS extraction (when LLM_PROVIDER is anthropic) and
# the voice-note extraction.
ANTHROPIC_API_KEY=

# OpenAI API key: Whisper, for voice notes, and the WCS extraction when
# LLM_PROVIDER is openai.
OPENAI_API_KEY=

# This cog's own named key for api-kaianolevine-com, sent as
# `Authorization: Bearer` on every request. No fallback: unset or wrong is a
# 401 on every call. See ecosystem-standards CD-019.
TRANSCRIPTION_COG_API_KEY=

# external tooling: read by miniapppolis-common-utils' KaianoApiClient.
# Base URL of api-kaianolevine-com. Production reads the unsuffixed name;
# every other environment reads KAIANO_API_BASE_URL_DEV, with no fallback
# between them.
KAIANO_API_BASE_URL_DEV=
# KAIANO_API_BASE_URL=

# external tooling: read by miniapppolis-common-utils' init_sentry, once per
# cold start, for both pipelines. Unset turns error tracking off.
# SENTRY_DSN_COGS=

# external tooling: read by miniapppolis-common-utils' environment module.
# Which environment this process is in. Doppler sets it per config
# (development in dev). On Lambda, the infra module sets it to "production";
# nothing else on the function would say so.
# ENVIRONMENT=

# Log level: DEBUG, INFO (default), WARN, ERROR. Re-applied at every
# invocation; an unrecognised value is logged and ignored.
# LOGGING_LEVEL=

# ---------------------------------------------------------------------------
# WCS pipeline (modes wcs-transcripts and wcs-note)
# ---------------------------------------------------------------------------

# Drive folders: new transcripts, and where processed ones are archived.
NOTES_INPUT_FOLDER_ID=
NOTES_PROCESSED_FOLDER_ID=

# The extraction's provider, anthropic (default) or openai, and its model
# (default per provider: claude-sonnet-4-6 / gpt-4.1-mini).
# LLM_PROVIDER=
# LLM_MODEL=

# Shortest text processed, in characters: a transcript (default 200), and an
# authored note, `… > Note - Topic` or `… > Correction - Topic`, where one
# sentence is a whole note (default 20).
# MIN_TRANSCRIPT_CHARS=
# MIN_NOTE_CHARS=

# ---------------------------------------------------------------------------
# Voice notes (modes voicenotes and voicenotes-cleanup)
# transcription_cog.voicenotes.config.Settings, which holds the budget
# these add up to: one job must fit in one Lambda invocation.
# ---------------------------------------------------------------------------

# Drive folder where new audio files appear.
GOOGLE_DRIVE_VOICE_INBOX_FOLDER_ID=

# Models: extraction (default claude-sonnet-4-6) and transcription
# (default whisper-1).
# CLAUDE_MODEL=
# WHISPER_MODEL=

# Days archived audio is kept (default 7), and the most one retention sweep
# does: expired date folders opened (default 3) and archived files trashed
# (default 5). The sweep runs after every note, so what one sweep leaves
# the next takes, oldest first.
# ARCHIVE_RETENTION_DAYS=
# CLEANUP_MAX_BUCKETS_PER_RUN=
# CLEANUP_MAX_FILES_PER_RUN=

# Timeouts, in seconds: outbound HTTP such as Drive (default 10), the
# extraction request (60), the longest wait before the Anthropic SDK's one
# retry of it (10), and the Whisper request (240). See the budget in
# voicenotes/config.py before raising any.
# HTTP_TIMEOUT_SECONDS=
# CLAUDE_REQUEST_TIMEOUT_SECONDS=
# CLAUDE_RETRY_WAIT_MAX_SECONDS=
# WHISPER_REQUEST_TIMEOUT_SECONDS=
