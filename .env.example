# Google Drive — folder IDs
NOTES_INPUT_FOLDER_ID=
NOTES_PROCESSED_FOLDER_ID=

# api-kaianolevine-com — internal API
KAIANO_API_BASE_URL=
KAIANO_API_INTERNAL_KEY=

# Prefect Cloud
PREFECT_API_KEY=
PREFECT_API_URL=

# Observability
SENTRY_DSN_NOTES_INGEST_COG=
HEALTHCHECKS_URL=
LOGGING_LEVEL=INFO
