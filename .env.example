# Google — service account credentials JSON (full JSON string)
# external tooling: consumed by common-python-utils (mini_app_polis.google);
# not declared on transcription_cog Settings.
GOOGLE_CREDENTIALS_JSON=

# LLM providers
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=   # optional — only needed if LLM_PROVIDER=openai

# LLM config
# external tooling: read at runtime by load_config() into Config.llm_provider
# (dataclass-backed). Settings-class checks won't see this; the value is still
# validated against {"anthropic", "openai"} at load time.
LLM_PROVIDER=anthropic
# LLM_MODEL=        # defaults per provider: claude-sonnet-4-6 / gpt-4.1-mini

# Google Drive — folder IDs (required for wcs-transcripts mode)
# external tooling: read into the dataclass-backed Config.notes_input_folder_id.
NOTES_INPUT_FOLDER_ID=
# external tooling: read into the dataclass-backed Config.notes_processed_folder_id.
NOTES_PROCESSED_FOLDER_ID=

# api-kaianolevine-com — internal API. This cog authenticates with its own
# named key (TRANSCRIPTION_COG_API_KEY); there is no fallback, so unset
# or wrong means 401 on every call. See ecosystem-standards CD-019.
KAIANO_API_BASE_URL=
TRANSCRIPTION_COG_API_KEY=YOUR_TRANSCRIPTION_COG_API_KEY

# Observability.
# external tooling: read by sentry_sdk.init in transcription_cog.worker, for
# both pipelines.
SENTRY_DSN=
# external tooling: read into Config.logging_level (also consumed by
# mini_app_polis.logger via the LOGGING_LEVEL convention).
LOGGING_LEVEL=INFO

# ---------------------------------------------------------------------------
# voicenotes sub-pipeline (merged from voicenotes-cog, May 2026)
#
# These env vars are only required when a run's mode is "voicenotes" or
# "voicenotes-cleanup". They live under
# transcription_cog.voicenotes.config.Settings (pydantic-settings).
# ---------------------------------------------------------------------------

# --- LLM providers ---
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY shared with the main WCS pipeline (declared above).

# --- Asana ---
# Long-lived personal access token (no OAuth, no refresh) — mint one at
# My Settings → Apps → Manage Developer Apps → Personal Access Tokens.
# Run `uv run python -m transcription_cog.voicenotes.scripts.setup_asana`
# to resolve the three gids below from their board names.
#
# The client is mini_app_polis.asana (common-python-utils); these vars
# are declared on the voicenotes Settings so every secret still flows
# through pydantic-settings + Doppler.
ASANA_ACCESS_TOKEN=
# Workspace gid. Needed because Asana tags are workspace-scoped
# objects, so resolving a tag name requires it.
ASANA_WORKSPACE_ID=
# Project gid — the board voice notes are posted to.
ASANA_INBOX_PROJECT_ID=
# Section gid — the intake column, where notes wait to be groomed.
# Optional: with it unset the task lands in whichever section is
# leftmost, which is a position rather than a decision.
ASANA_INBOX_SECTION_ID=

# --- Google Drive ---
# Drive folder where new audio files appear. Reuses the same service
# account JSON as the main pipeline (GOOGLE_CREDENTIALS_JSON above).
GOOGLE_DRIVE_VOICE_INBOX_FOLDER_ID=

# --- Observability ---
# Sentry: voicenotes errors flow through the parent cog's Sentry DSN
# (SENTRY_DSN above). SENTRY_DSN_VOICENOTES is kept for backward compat
# with operator runbooks; the worker ignores it.
SENTRY_DSN_VOICENOTES=

# --- Behavior tuning (optional) ---
# Defaults are reasonable; override only if needed.
ARCHIVE_RETENTION_DAYS=7
CLAUDE_MODEL=claude-sonnet-4-6
WHISPER_MODEL=whisper-1

# Retries for a transient Asana failure when posting a voice note. Every
# other call goes through a client that retries itself.
TASK_RETRIES=3
TASK_RETRY_DELAYS_SECONDS=[5,15,30]

# Which environment this process is in. On Lambda, infra/worker.tf sets it
# to "production"; nothing else on the function would say so.
ENVIRONMENT=local

# external tooling: resolved by mini_app_polis.environment
# (common-python-utils) when the client builds its base URL; no
# transcription_cog Settings class reads it.
# Base URL of api-kaianolevine-com. Production reads the unsuffixed name;
# every other environment reads KAIANO_API_BASE_URL_DEV (declared with
# KAIANO_API_BASE_URL above), with no fallback between them.
KAIANO_API_BASE_URL_DEV=

# external tooling
# LLM request timeouts. Sized so one voice note, SDK retries included, fits
# in one Lambda invocation — see the budget in voicenotes/config.py before
# raising either.
CLAUDE_REQUEST_TIMEOUT_SECONDS=60
WHISPER_REQUEST_TIMEOUT_SECONDS=240
